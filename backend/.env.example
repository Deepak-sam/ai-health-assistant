# Copy to .env for local development. Never commit the real .env file.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro

# Firebase project used for ID token verification
FIREBASE_PROJECT_ID=

# Garmin Health API / Connect Developer Program credentials (server-side OAuth only)
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=https://your-backend-url/api/v1/garmin/oauth/callback

# App
BACKEND_URL=http://localhost:8080
ALLOWED_ORIGINS=*
MAX_PHOTO_BYTES=8388608

# Comma-separated list of family member emails allowed to use this instance
ALLOWLISTED_EMAILS=parent@example.com,teen@example.com
